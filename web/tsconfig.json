{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "lispm-remote-web": ["./pkg/lispm_remote_web.d.ts"],
      "lispm-remote-client": ["./pkg/lispm_remote_client.d.ts"],
      "rings-node": ["./node_modules/@ringsnetwork/rings-node/dist/rings_node.d.ts"]
    }
  },
  "include": ["src"]
}
